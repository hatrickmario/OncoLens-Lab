{
  "version": 1,
  "formatsVersion": 1,
  "descripcion": "Reglas de reemplazo del enmascarado de PII en ejecución (RN-11, RN-22). Los formatos viven SOLO en config/pii-formats.json (L1D-166); aquí van los marcadores por tipo de ese archivo, las de la identidad conocida, el orden de aplicación y la regla de fechas en texto libre (que no es un formato de PII). 'formatsVersion' debe ser igual a la 'version' de pii-formats.json: si no, clinical-api no arranca.",
  "marcadores": {
    "documento_identidad": "[DOCUMENTO]",
    "telefono": "[TELEFONO]",
    "correo": "[CORREO]"
  },
  "identidad": {
    "nombre": "[NOMBRE]",
    "documento": "[DOCUMENTO]",
    "telefono": "[TELEFONO]"
  },
  "orden": ["identidad", "fechas", "formatos"],
  "fechas": {
    "marcador": "[FECHA]",
    "meses": [
      "enero",
      "febrero",
      "marzo",
      "abril",
      "mayo",
      "junio",
      "julio",
      "agosto",
      "septiembre",
      "setiembre",
      "octubre",
      "noviembre",
      "diciembre",
      "ene",
      "feb",
      "mar",
      "abr",
      "may",
      "jun",
      "jul",
      "ago",
      "sept",
      "sep",
      "set",
      "oct",
      "nov",
      "dic",
      "january",
      "february",
      "march",
      "april",
      "june",
      "july",
      "august",
      "september",
      "october",
      "november",
      "december",
      "jan",
      "apr",
      "aug",
      "dec"
    ],
    "banderas": "iu",
    "patrones": [
      "(?<![\\p{N}])\\d{4}(?<s>[-/.])\\d{2}\\k<s>\\d{2}(?:[T ]\\d{2}:\\d{2}(?::\\d{2})?)?(?![\\p{N}])",
      "(?<![\\p{N}])\\d{1,2}(?<s>[/.-])\\d{1,2}\\k<s>\\d{2,4}(?![\\p{N}])",
      "(?<![\\p{L}\\p{N}])(?:\\d{1,2}\\s+(?:de\\s+)?)?(?:{{meses}})\\.?,?\\s+(?:(?:de|del)\\s+)?(?:\\d{1,2},?\\s+)?\\d{4}(?![\\p{N}])"
    ]
  }
}

{
  "name": "@oncolens/clinical-api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Backend 1 (clinical-api): dueño de PostgreSQL y clinical-minio. Express 5 + TypeScript.",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "oncolens": "dist/apps/clinical-api/src/cli/oncolens.js"
  },
  "scripts": {
    "oncolens": "node dist/apps/clinical-api/src/cli/oncolens.js",
    "oncolens:dev": "tsx src/cli/oncolens.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/clinical-api/src/server.js",
    "eval:pii": "tsx src/cli/medir-pii.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "express": "5.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "msw": "3.0.3",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}

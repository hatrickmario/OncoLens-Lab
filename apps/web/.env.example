# Variables del BFF de web (US-045, L1D-139). Sin secretos: son orígenes y tiempos.
# Origen permitido para las peticiones POST del navegador (verificación de Origin, CSRF).
WEB_ALLOWED_ORIGIN=http://127.0.0.1:3000
# Tiempo máximo de espera hacia clinical-api (ms). Debe ser menor que el deadline de clinical-api.
WEB_UPSTREAM_TIMEOUT_MS=40000

# Modelos locales, chunking e índice: decisión del ADR-39 (fase A). No editar sin actualizar el ADR.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIM=1024
SPARSE_VECTOR_SOURCE=modelo_embeddings
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_MAX_PAIRS=12
RERANKER_MAX_LENGTH=512
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_MODEL_REVISION=b5113eb38ab63efdd7f280f8c144ea8b13f978ce
MODEL_QUANTIZATION=int8
NLI_QUANTIZATION=fp32
MODEL_CACHE_DIR=/models
DATA_CACHE_DIR=/data-cache
CORPUS_CHUNK_SIZE=1024
CORPUS_CHUNK_OVERLAP=0
CORPUS_CHUNKING_STRATEGY=tamano_fijo
VECTOR_INDEX_TYPE=HNSW
VECTOR_INDEX_PARAMS='{"M": 16, "efConstruction": 200, "ef": 64}'
CHUNK_SELECTION_MARGIN=0.02
INDEX_MIN_RECALL_VS_FLAT=0.99
STACK_MEMORY_LIMIT_GB=30
LLM_MEMORY_BUDGET_GB=21
STAGE_P95_BUDGET_MS='{"embeddings": 500, "reranker": 4500, "nli": 1500}'
ACADEMIC_LICENSES=mit,apache-2.0

# Corpus semilla (US-056, L1D-115). Valores a calibrar (RN-22).
CORPUS_SEED_MANIFEST_PATH=/data/raw/seed/manifest.yaml
# RN-21: solo licencias abiertas. CC BY-NC exige además ALLOW_CC_BY_NC=true y 'nc_solo_academico: true' por documento; ND siempre se rechaza.
CORPUS_ACCEPTED_LICENSES=dominio_publico,cc_by,cc_by_sa
CORPUS_EXCLUDED_SOURCES=NCCN,ESMO
# Fecha de corte: la de la descarga de los documentos de la semilla (AAAA-MM-DD).
CORPUS_CUTOFF_DATE=2026-10-16
# Vacío = sin descargas. Para cargar la semilla: www.cancer.gov,pmc.ncbi.nlm.nih.gov,pmc-oa-opendata.s3.amazonaws.com
CORPUS_FETCH_ALLOWED_HOSTS=
CORPUS_FETCH_TIMEOUT_SECONDS=30
CORPUS_FETCH_MAX_BYTES=5000000
CORPUS_FETCH_DEADLINE_SECONDS=60

# RN-21: CC BY-NC solo en el MVP académico. Con false (por defecto) el cargador de datasets rechaza esas fuentes;
# con true, además, cada fuente CC BY-NC debe llevar 'nc_solo_academico: true' en el manifiesto.
ALLOW_CC_BY_NC=false

# Corpus (US-058, L1D-114): catálogo en PostgreSQL y colección en Milvus. Sin contraseñas en las URLs (RN-14).
CORPUS_DATABASE_URL=postgresql+psycopg://rag_corpus@postgres:5432/oncolens?sslmode=require
PG_RAG_CORPUS_PASSWORD_FILE=/run/secrets/pg_rag_corpus_password
# Solo el one-shot corpus-migrate (Alembic) lee estas dos; el runtime no las recibe.
CORPUS_MIGRATOR_DATABASE_URL=postgresql+psycopg://rag_corpus_migrator@postgres:5432/oncolens?sslmode=require
PG_RAG_CORPUS_MIGRATOR_PASSWORD_FILE=/run/secrets/pg_rag_corpus_migrator_password
MILVUS_URI=http://milvus-standalone:19530
MILVUS_COLLECTION_NAME=corpus_chunks
# La métrica del índice dense no la fija ADR-39; T5 midió con COSINE. Tipo y parámetros: VECTOR_INDEX_TYPE/PARAMS.
MILVUS_DENSE_METRIC_TYPE=COSINE
MILVUS_SPARSE_INDEX_TYPE=SPARSE_INVERTED_INDEX
MILVUS_SPARSE_METRIC_TYPE=IP
# Longitudes máximas de los VARCHAR de corpus_chunks (RN-22).
MILVUS_LEN_CHUNK_ID=128
MILVUS_LEN_DOCUMENT_ID=128
MILVUS_LEN_CHUNK_TEXT=16384
MILVUS_LEN_SECTION=512
MILVUS_LEN_SOURCE_TYPE=64
MILVUS_LEN_LANGUAGE=16
MILVUS_LEN_CANCER_TYPE_TAGS=512
MILVUS_LEN_POPULATION=64
MILVUS_LEN_STUDY_DESIGN=64

# Recuperación y umbral de "sin evidencia" (US-055, L1D-106). Valores a calibrar (RN-22); provisionales hasta la suite evaluate (US-072).
RELEVANCE_THRESHOLD=0.30
RETRIEVAL_TOP_K=30
RERANK_TOP_N=10
# Longitud máxima del tipo de cáncer aceptado en la consulta (opcional).
RETRIEVAL_CANCER_TYPE_MAX_LENGTH=64

# Modelos locales de recuperación (US-231a, ADR-39, RN-12, RN-22). fake = adapters falsos (CI); local = modelos reales verificados por SHA-256.
MODEL_PROVIDER=local
DEFAULT_QUERY_LANGUAGE=es
# Rutas dentro de MODEL_CACHE_DIR (montaje de solo lectura de MODEL_HOST_DIR) y SHA-256 de cada archivo; vacíos hasta descargar los pesos (fuera del repo).
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL_SHA256=
EMBEDDING_TOKENIZER_PATH=
EMBEDDING_TOKENIZER_SHA256=
# Pesos del vector sparse léxico de BGE-M3 (sparse_linear.npz; L1D-116, SPARSE_VECTOR_SOURCE=modelo_embeddings). Sin ellos la ingesta falla en cerrado nombrando la variable. Fuera del repo.
EMBEDDING_SPARSE_WEIGHTS_PATH=
EMBEDDING_SPARSE_WEIGHTS_SHA256=
RERANKER_MODEL_PATH=
RERANKER_MODEL_SHA256=
RERANKER_TOKENIZER_PATH=
RERANKER_TOKENIZER_SHA256=
EMBEDDING_MAX_LENGTH=8192
MODEL_INTRA_OP_THREADS=8
MODEL_BATCH_MAX_TOKENS=4096

# Generación con el LLM local (L1D-275). Valores a calibrar (RN-22).
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=1024
PROMPT_VERSION=rag-query@0.1.0

# Metadatos de población del corpus (L1D-117, RN-22). La ingesta escribe una muestra para medir M-08.4; el LLM de extracción es local y determinista.
CORPUS_METADATA_SAMPLE_PCT=10.0
CORPUS_METADATA_SAMPLE_SEED=oncolens-metadatos
# Ruta relativa al directorio de trabajo: lanzar la ingesta desde la raíz del repo.
CORPUS_METADATA_SAMPLE_DIR=data/evaluation/corpus-metadatos
CORPUS_METADATA_LLM_TEMPERATURE=0.0

# Subcomando `ingest reindex-sparse` (US-117b, RN-22): recalcula el sparse de la semilla con los pesos locales de BGE-M3; no usa LLM.
# Exige embeddings locales (MODEL_PROVIDER=local) y EMBEDDING_SPARSE_WEIGHTS_PATH/_SHA256 verificados.
CORPUS_SPARSE_REINDEX_BATCH_SIZE=64

# Medición de la fase B de ADR-39 (L1D-274). Valores a calibrar (RN-22).
# Contexto y temperatura del LLM local (el servidor Ollama debe arrancar con OLLAMA_CONTEXT_LENGTH=8192).
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0
# OCR local (sin envío a la nube, RN-12).
OCR_ENGINE=ocrmypdf-tesseract
OCR_LANGUAGES=spa

# Soporte NLI y catálogo clínico (L1D-180). Valores a calibrar (RN-22).
# Umbral de p_entailment para dar soporte: provisional hasta la suite evaluate (US-072).
NLI_ENTAILMENT_THRESHOLD=0.7
CLINICAL_CATALOG_PATH=/catalogs
# RN-12: el LLM solo puede estar en estos hosts (sin fallback a la nube).
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# LLM local elegido en ADR-39 fase B (L1D-274). Decidido (usuario, 2026-10-20): Ollama + gemma4:26b-a4b-it-q4_K_M.
LLM_MODEL=gemma4:26b-a4b-it-q4_K_M

# Recuperación híbrida (US-112). Valores válidos: dense | hibrida. Se queda en dense hasta que US-133 mida; hibrida exige la rama sparse (pesos con SHA-256).
RETRIEVAL_MODE=dense
# Regla que fusiona dense y sparse en modo hibrida: rrf | ponderada.
RETRIEVAL_FUSION=rrf
# Constante k de RRF (entero >= 1); el rango lo valida Settings al arrancar.
RRF_K=60
# Peso de la rama sparse con fusión ponderada (0 < w < 1); el rango lo valida Settings al arrancar.
HYBRID_SPARSE_WEIGHT=0.3

# Población del estudio en lista (ADR-47). Tope de valores por criterio y fragmento; valor a calibrar (RN-22).
POPULATION_MAX_VALUES_PER_CRITERION=3

# --- Extracción de la población del estudio en la ingesta (ADR-47, US-242 / L1D-292) ---
# Valores por defecto del spike US-240 (reports/spikes/s4-capacidad-paralelismo.md, §7); todos son valores a calibrar (RN-22).
# Tareas cortas por documento y criterio, una a la vez: con el LLM local de ADR-39 más solicitudes simultáneas no ganan
# rendimiento (informe §2 y §4). Medido en una máquina de 48 GB; repetir en el equipo de referencia de 32 GB antes de subirlo.

# Concurrencia de las tareas de extracción (1 = una a la vez). Informe §2 y §4.
POPULATION_EXTRACTION_CONCURRENCY=1
# Fragmentos recuperados por documento y criterio para extraer la población. Informe §5 (k = 2 pierde valores; k = 6 cuesta +26 % de tiempo).
POPULATION_EXTRACTION_TOP_K=4
# Tope de tokens de salida de cada tarea (el máximo observado fue 220). Informe §2.
POPULATION_EXTRACTION_MAX_OUTPUT_TOKENS=512
# Reintentos de una tarea con salida inválida o truncada (una sola vez, con otra semilla).
POPULATION_EXTRACTION_RETRIES=1
# Versión del prompt de extracción (se registra en la caché por documento + criterio + versión).
POPULATION_PROMPT_VERSION=poblacion_v1
# Plazo total del respaldo de población en la consulta, en milisegundos, para una sola tarea (lo usa L1D-294 / US-244).
# Informe §6: cubre el p95 (7,3 s) y el máximo (8,65 s) de una tarea con el modelo ya cargado; no cubre el arranque en frío.
POPULATION_FALLBACK_DEADLINE_MS=10000
# Servidor Ollama (variable del proceso de Ollama, no de rag-orchestrator; va en el arranque del servidor o en su documento de puesta en marcha):
# OLLAMA_NUM_PARALLEL=1

# --- Juez local de la suite evaluate (L1D-298 / US-233a). Supuestos sin calibrar (RN-22). ---
# Acuerdo mínimo del juez con el NLI y muestra mínima para que la fidelidad sea concluyente.
JUEZ_ACUERDO_MINIMO=0.8
JUEZ_MUESTRA_MINIMA=30
# Temperatura y semilla del juez (reproducibilidad, ADR-41 AC-2).
EVAL_JUDGE_TEMPERATURE=0
EVAL_JUDGE_SEED=20261021

# --- Afirmaciones atómicas por opción (L1D-295 / US-245, RN-22). Valores iniciales a calibrar con la suite evaluate. ---
# De CLAIMS_MIN_PER_OPTION a CLAIMS_MAX_PER_OPTION afirmaciones por opción (una es la principal); una salida fuera de esos límites no se repara.
CLAIMS_MIN_PER_OPTION=1
CLAIMS_MAX_PER_OPTION=4
# Palabras máximas de una afirmación atómica; más es «fuera de forma».
CLAIM_MAX_WORDS=20

# --- Comparación híbrida frente a dense (L1D-245 / US-133, RN-22). ---
# Regresión tolerada de una métrica del brazo híbrido frente a dense. Sin valor hasta fijar la preinscripción (ADR-45 P1).
RETRIEVAL_REGRESSION_TOLERANCE=

# --- Segundo loop de reescritura de la consulta (L1D-300 / US-238, RN-02 enmendada, RN-22). Valores iniciales a calibrar con evaluate. ---
# Desactivado por defecto hasta que la evaluación (AC-9) fije el valor; con false el comportamiento es el de siempre (un solo loop).
QUERY_REWRITE_ENABLED=false
# Loops adicionales de reescritura con el LLM local; 1 = un único segundo loop.
QUERY_REWRITE_MAX_ITERATIONS=1
# Plazo de la reescritura en milisegundos.
QUERY_REWRITE_DEADLINE_MS=3000
# Tope de tokens de salida y de términos de la consulta reescrita (solo términos del catálogo).
QUERY_REWRITE_MAX_OUTPUT_TOKENS=128
QUERY_REWRITE_MAX_TERMS=5

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "poblacion.json: claves de population_criteria que un studyKey puede nombrar (L1D-126)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "keys"],
  "properties": {
    "version": { "$ref": "comun.schema.json#/$defs/version" },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "cancerTypes"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)?$" },
          "cancerTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z]+$" }
          }
        }
      }
    }
  }
}

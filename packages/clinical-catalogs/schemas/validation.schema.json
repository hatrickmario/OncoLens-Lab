{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation.schema.json",
  "title": "Bloque validation de un archivo de catálogo revisado (L1D-93 D4): una sola definición para todos los archivos",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "status", "reviewerRole", "date", "catalogHash"],
  "properties": {
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["datos_criticos", "matriz_item_campo", "aplicabilidad"] }
    },
    "status": { "type": "string", "pattern": "^[a-z_]+$" },
    "reviewerRole": { "type": "string", "pattern": "^[a-z_]+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "catalogHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

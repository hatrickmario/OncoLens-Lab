{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest.json del catálogo clínico",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cancerTypes",
    "standards"
  ],
  "properties": {
    "version": { "$ref": "comun.schema.json#/$defs/version" },
    "cancerTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+$"
      }
    },
    "poblacionReglas": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalogHash"],
        "properties": {
          "catalogHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "standards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "cie10",
          "loinc",
          "atc",
          "cups"
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sinonimos.json por tipo de cáncer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "terminoCanonico",
          "sinonimos"
        ],
        "properties": {
          "terminoCanonico": {
            "type": "string",
            "minLength": 1
          },
          "sinonimos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "texto",
                "idioma"
              ],
              "properties": {
                "texto": {
                  "type": "string",
                  "minLength": 1
                },
                "idioma": {
                  "enum": [
                    "es",
                    "en"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

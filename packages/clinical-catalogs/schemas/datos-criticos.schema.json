{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "datos-criticos.json (FEAT-04, L1D-93)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": { "$ref": "comun.schema.json#/$defs/version" },
    "verifiedReviewStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "validation": { "$ref": "validation.schema.json" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "condicion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "operator", "values"],
      "properties": {
        "item": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "operator": { "enum": ["igualdad", "pertenencia", "prefijo"] },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "cumplimientoAlternativo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "attribute_key", "value"],
      "properties": {
        "entity": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
        "attribute_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "cancerType", "label", "destination", "minValues", "sourceDocumentTypes", "estado"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "cancerType": { "type": "string", "pattern": "^[a-z]+$" },
        "label": { "$ref": "comun.schema.json#/$defs/etiqueta" },
        "destination": { "$ref": "comun.schema.json#/$defs/destino" },
        "condition": { "$ref": "#/$defs/condicion" },
        "whenConditionUnknown": { "enum": ["faltante", "no_aplica"] },
        "satisfiedBy": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cumplimientoAlternativo" }
        },
        "minValues": { "type": "integer", "minimum": 1 },
        "sourceDocumentTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["historia_clinica", "examen"] }
        },
        "estado": { "$ref": "comun.schema.json#/$defs/estado" }
      },
      "if": { "properties": { "condition": true }, "required": ["condition"] },
      "then": { "properties": { "whenConditionUnknown": true }, "required": ["whenConditionUnknown"] }
    }
  }
}

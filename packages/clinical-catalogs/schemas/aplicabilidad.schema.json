{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aplicabilidad.json (lo llena FEAT-08b; L1D-93 fija el bloque validation y el destino de cada ítem)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": { "type": "string", "pattern": "^(test-)?\\d+\\.\\d+\\.\\d+$" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "reviewerRole", "date", "catalogHash"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["datos_criticos", "matriz_item_campo", "aplicabilidad"] }
        },
        "status": { "type": "string", "pattern": "^[a-z_]+$" },
        "reviewerRole": { "type": "string", "pattern": "^[a-z_]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "catalogHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "items": { "type": "array", "items": { "type": "object" } }
  }
}

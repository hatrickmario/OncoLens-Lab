    "parches": [
      {
        "destino": "rag-orchestrator",
        "operaciones": [
          {
            "op": "add",
            "path": "/components/schemas/ClinicalContext/dependentSchemas",
            "value": { "currentLine": { "properties": { "nationalId": { "type": "string" } } } }
          }
        ]
      }
    ],
    "esperado": { "archivo": "apps/rag-orchestrator/openapi.yaml", "rutaContiene": "dependentSchemas" }
  },
  {
    "ac": "AC-17",
    "regla": "assertNoIdentityInRagContract",
    "escenario": "un parche agrega nationalId bajo $defs de un schema de Backend 2",

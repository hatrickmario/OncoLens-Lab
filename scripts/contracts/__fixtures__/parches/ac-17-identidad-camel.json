      {
        "destino": "rag-orchestrator",
        "operaciones": [
          { "op": "add", "path": "/components/schemas/RagFiltersApplied/$defs", "value": { "interno": { "type": "object", "properties": { "nationalId": { "type": "string" } } } } }
        ]
      }
    ],
    "esperado": { "archivo": "apps/rag-orchestrator/openapi.yaml", "rutaContiene": "$defs" }

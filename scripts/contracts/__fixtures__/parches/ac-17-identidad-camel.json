  {
    "ac": "AC-17",
    "regla": "assertNoIdentityInRagContract",
    "escenario": "un parche agrega nationalId dentro de prefixItems de RagQueryInternalRequest (DPR-3)",
    "parches": [
      {
        "destino": "rag-orchestrator",
        "operaciones": [
          {
            "op": "add",
            "path": "/components/schemas/RagQueryInternalRequest/properties/pares",
            "value": { "type": "array", "prefixItems": [{ "type": "object", "properties": { "nationalId": { "type": "string" } } }] }
          }
        ]
      }
    ],
    "esperado": { "archivo": "apps/rag-orchestrator/openapi.yaml", "rutaContiene": "prefixItems" }

      {
        "destino": "rag-orchestrator",
        "operaciones": [
          {
            "op": "add",
            "path": "/components/schemas/RagQueryInternalRequest/properties/pares",
            "value": { "type": "array", "contains": { "type": "object", "properties": { "nationalId": { "type": "string" } } } }
          }
        ]
      }
    ],
    "esperado": { "archivo": "apps/rag-orchestrator/openapi.yaml", "rutaContiene": "contains" }

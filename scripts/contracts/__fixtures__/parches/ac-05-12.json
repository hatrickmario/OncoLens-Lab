  {
    "ac": "AC-7",
    "regla": "assertDerivedEventDescription",
    "escenario": "un parche restaura la frase de readme sobre el evento analisis_ia",
    "parches": [
      {
        "destino": "clinical-api",
        "operaciones": [
          {
            "op": "replace",
            "path": "/paths/~1platform~1evidence-analyses/post/description",
            "value": "Agrega la Base del análisis, persiste AIAnalysisRecord y el evento analisis_ia antes de responder."
          }
        ]
      }
    ],
    "esperado": { "archivo": "apps/clinical-api/openapi.yaml", "rutaContiene": "evidence-analyses/post/description", "mensajeContiene": "evento" }
  },
  {
    "ac": "AC-7",
    "regla": "assertDerivedEventDescription",
    "escenario": "la descripción de la operación deja de decir evento derivado",
    "parches": [
      {
        "destino": "clinical-api",
        "operaciones": [{ "op": "replace-text", "path": "/paths/~1platform~1evidence-analyses/post/description", "buscar": "evento derivado", "reemplazar": "registro" }]
      }
    ],
    "esperado": { "archivo": "apps/clinical-api/openapi.yaml", "mensajeContiene": "evento derivado" }
  },
  {
    "ac": "AC-8",
    "regla": "assertSharedSchemasSingleOrigin",
    "escenario": "un parche define en línea una copia de EvidenceOption con un campo distinto en clinical-api",
    "parches": [
      {
        "destino": "clinical-api",
        "operaciones": [
          {
            "op": "replace",
            "path": "/components/schemas/EvidenceOption",
            "value": { "type": "object", "additionalProperties": false, "required": ["option", "extra"], "properties": { "option": { "type": "string" }, "extra": { "type": "string" } } }
          }
        ]
      }
    ],
    "esperado": { "archivo": "apps/clinical-api/openapi.yaml", "rutaContiene": "#/components/schemas/EvidenceOption", "mensajeContiene": "en línea" }
  },
  {
    "ac": "AC-8",
    "regla": "assertSharedSchemasSingleOrigin",
    "escenario": "evidence.yaml define Provenance, que no es compartido",

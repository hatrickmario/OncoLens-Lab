<mxfile host="app.diagrams.net" agent="OncoLens" version="24.0.0">
  <diagram id="c4-context" name="Nivel 1 - Contexto">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ctx_doctor" value="&lt;b&gt;Oncólogo&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Piloto inicial: 10 oncólogos. Busca pacientes, carga documentos, consulta evidencia, revisa datos extraídos y registra decisiones. Accede solo por red privada o VPN.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="140" as="geometry" />
        </mxCell>

        <mxCell id="ctx_admin" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gestiona usuarios, equipo tratante, egresos y el seguimiento de retención y consentimientos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="ctx_oncolens" value="&lt;b&gt;OncoLens&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema de software — MVP académico]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cruza el perfil clínico y molecular del paciente con evidencia publicada (búsqueda híbrida multilingüe ES/EN) y presenta opciones de tratamiento con citas verificables y relevancia de la evidencia. No estima probabilidad de éxito. Corre en local: Docker Compose + LLM nativo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=13;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="250" width="340" height="220" as="geometry" />
        </mxCell>

        <mxCell id="ctx_ext" value="&lt;b&gt;Fuentes científicas externas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Solo texto, con licencia registrada: NCI PDQ (EN/ES), ClinicalTrials.gov, PubMed/PMC y publicaciones de TCGA/GDC, cBioPortal y TCIA. NCCN y ESMO: pendientes de licencia.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="60" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="ctx_cloud" value="&lt;b&gt;LLM en la nube (opcional)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Deshabilitado por defecto. Solo para pruebas con datos sintéticos; los datos reales nunca salen del equipo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ctx_entity" value="&lt;b&gt;Entidad médica / colaboradores&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Contrato o convenio marco. Entregan datasets reales anonimizados (calibración y pruebas) y marcas de exclusión (opt-out) de investigación.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="520" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e1" value="Consulta pacientes y evidencia, carga documentos&#10;[HTTPS, red privada/VPN]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="ctx_doctor" target="ctx_oncolens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e2" value="Administra&#10;[HTTPS, red privada/VPN]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="ctx_admin" target="ctx_oncolens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e3" value="Ingiere publicaciones con licencia&#10;[batch]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="ctx_oncolens" target="ctx_ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e4" value="Inferencia solo con datos sintéticos&#10;[HTTPS, opcional]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;dashed=1;" edge="1" parent="1" source="ctx_oncolens" target="ctx_cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e5" value="Datasets anonimizados y opt-outs&#10;[importación]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="ctx_entity" target="ctx_oncolens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ctx_note" value="Alcance clínico del piloto: cáncer de mama y de próstata; leucemia como tercer tipo cuando cumpla su criterio de &quot;listo&quot;. Toda salida: &quot;Recomendación generada por IA — requiere validación clínica&quot; y &quot;Uso académico/investigación&quot;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="640" width="620" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-container" name="Nivel 2 - Contenedores">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="con_boundary" value="OncoLens — MacBook Pro M5 (FileVault) · Docker Compose + LLM nativo" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="1030" height="940" as="geometry" />
        </mxCell>

        <mxCell id="con_net_clin" value="red clinical-net (clinical-api está en ambas redes)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="460" height="760" as="geometry" />
        </mxCell>

        <mxCell id="con_net_ai" value="red ai-net" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="745" y="300" width="510" height="540" as="geometry" />
        </mxCell>

        <mxCell id="con_doctor" value="&lt;b&gt;Oncólogo / Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="con_web" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Next.js / React 19 (BFF)]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UI del doctor y único punto público (HTTPS, CA interna). Route Handlers como proxy de todos los endpoints; cookie SameSite=Strict + verificación de Origin. Nunca tokens del LLM sin validar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="con_be1" value="&lt;b&gt;clinical-api&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Node.js LTS / Express 5]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Plataforma clínica + gateway de IA. Auth, equipo tratante, consentimientos, identidad cifrada (índice ciego), documentos, revisión OCR, análisis, retención. Worker de extracción y jobs. Sin puerto al host.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="240" height="170" as="geometry" />
        </mxCell>

        <mxCell id="con_pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Base de datos]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Schemas auth · identity (cifrado) · clinical · audit · research (solo inserción).&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="640" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="con_cminio" value="&lt;b&gt;clinical-minio&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Object storage]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bucket clinical-documents (PDFs). Solo clinical-api tiene credenciales y red.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="640" width="190" height="140" as="geometry" />
        </mxCell>

        <mxCell id="con_be2" value="&lt;b&gt;rag-orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Python / FastAPI]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Recuperación híbrida multilingüe, reranker, generación, citas y soporte NLI; extracción (capa de texto/OCR, gate de PII, confianza por campo); ingesta del corpus. Embeddings, reranker y NLI en CPU. Sin acceso a PostgreSQL ni a clinical-minio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="260" height="190" as="geometry" />
        </mxCell>

        <mxCell id="con_milvus" value="&lt;b&gt;Milvus&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Base de datos vectorial (+ etcd + MinIO propio)]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;corpus_chunks: dense + sparse, is_current, source_type, language, cancer_type_tags, population.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="640" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="con_cat" value="&lt;b&gt;corpus-catalog&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: SQLite (volumen)]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CorpusDocument: licencia, versión, idioma, estado de ingesta.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="640" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="con_llm" value="&lt;b&gt;LLM nativo&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Proceso nativo macOS — fuera de Docker]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ollama o vLLM con GPU Metal; API compatible con OpenAI. Modelo fijado por el ADR-0001.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="110" width="230" height="140" as="geometry" />
        </mxCell>

        <mxCell id="con_cloud" value="&lt;b&gt;LLM en la nube (opcional)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Solo datos sintéticos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="380" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="con_ext" value="&lt;b&gt;Fuentes científicas externas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PDQ, ClinicalTrials.gov, PubMed/PMC, publicaciones TCGA/GDC, cBioPortal, TCIA.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="650" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="con_e1" value="Usa&#10;[HTTPS, red privada/VPN]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_doctor" target="con_web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e2" value="Proxy de la API&#10;[HTTP interno, cookie de sesión]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_web" target="con_be1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e3" value="Lee/escribe&#10;[Prisma, SQL, TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be1" target="con_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e4" value="Guarda/lee PDFs&#10;[S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be1" target="con_cminio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e5" value="Consultas RAG (contexto desidentificado) y extracción (PDF en el body)&#10;[HTTP, JWT de servicio ES256]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be1" target="con_be2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e6" value="Búsqueda dense/sparse&#10;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be2" target="con_milvus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e7" value="Catálogo y versionado&#10;[SQLite]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be2" target="con_cat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e8" value="Generación, estructuración, expansión&#10;[host.docker.internal, API OpenAI-compatible]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be2" target="con_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e9" value="Solo datos sintéticos&#10;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;dashed=1;" edge="1" parent="1" source="con_be2" target="con_cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e10" value="Ingesta batch&#10;[licencia registrada]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be2" target="con_ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_note" value="Solo web publica un puerto (interfaz de la red privada/VPN). rag-orchestrator está solo en ai-net: sin ruta hacia PostgreSQL ni clinical-minio. /health y /metrics en ambos backends; Prometheus + Grafana y OpenTelemetry: ADR futuro. Datos reales solo tras el Sprint 5 y el gate G-piloto." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="250" y="990" width="1030" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-component" name="Nivel 3 - Componentes">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="cmp_note" value="Zoom a los 2 contenedores con estructura interna relevante. Web (Next.js) actúa como BFF y no tiene diagrama de componentes propio por ahora." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cmp_b1" value="clinical-api (Backend 1)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="780" height="900" as="geometry" />
        </mxCell>

        <mxCell id="cmp_mw" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Guard de sesión · autorización (RBAC + equipo tratante + consentimiento) · Origin/CSRF · rate limit · Zod · traceId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#5C1A18;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="330" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cmp_users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — módulo users]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Login/logout, sesiones (TTL, inactividad), Argon2id, bloqueo por intentos, RBAC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_patients" value="&lt;b&gt;Patients&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — patients · episodes · care-team · consents]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Registro (manual / asistido por OCR), listado y búsqueda, episodios (egreso/reactivación), equipo tratante, consentimientos y bajas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="230" height="120" as="geometry" />
        </mxCell>


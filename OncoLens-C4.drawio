<mxfile host="app.diagrams.net" agent="OncoLens" version="24.0.0">
  <diagram id="c4-context" name="Nivel 1 - Contexto">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ctx_doctor" value="&lt;b&gt;Doctor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Oncólogo que consulta pacientes y solicita recomendaciones de tratamiento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ctx_oncolens" value="&lt;b&gt;OncoLens&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema de software]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cruza el perfil clínico y molecular del paciente con evidencia científica (guías, ensayos, datos genómicos) mediante búsqueda semántica híbrida para recomendar tratamiento personalizado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=13;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="300" height="180" as="geometry" />
        </mxCell>

        <mxCell id="ctx_llm" value="&lt;b&gt;Proveedor de LLM&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Modelos de generación y de embedding — self-hosted o cloud, configurable (pendiente ADR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ctx_ext" value="&lt;b&gt;Fuentes científicas externas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NCI, PDQ, ensayos clínicos y plataformas de investigación genómica&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e1" value="Consulta pacientes y solicita recomendaciones de tratamiento&#10;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="ctx_doctor" target="ctx_oncolens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx_e2" value="Solicita embeddings e inferencia&#10;[HTTPS/API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="ctx_oncolens" target="ctx_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx_e3" value="Ingiere guías, ensayos y datos genómicos&#10;[batch]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="ctx_oncolens" target="ctx_ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-container" name="Nivel 2 - Contenedores">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="con_boundary" value="OncoLens" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="1080" height="650" as="geometry" />
        </mxCell>

        <mxCell id="con_web" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Next.js / React 19]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Panel del doctor y panel de interacción IA. App Router, RSC, Route Handler para streaming de la consulta RAG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="con_be1" value="&lt;b&gt;clinical-api&lt;/b&gt; (Backend 1 — BFF)&lt;br&gt;&lt;i&gt;[Contenedor: Node.js LTS / Express 5]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Auth/Authz, lógica de negocio, API de plataforma, gateway hacia Backend 2. Dueño exclusivo de PostgreSQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="100" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="con_be2" value="&lt;b&gt;rag-orchestrator&lt;/b&gt; (Backend 2)&lt;br&gt;&lt;i&gt;[Contenedor: Python / FastAPI]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Retrieval dense/sparse/híbrido, extracción de documentos (OCR con IA), ingesta del corpus externo. Sin acceso de red a PostgreSQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="330" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="con_pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Base de datos]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Usuarios/roles, historia clínica, exámenes, biomarcadores, historial de análisis IA, auditoría&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="330" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="con_milvus" value="&lt;b&gt;Milvus&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Base de datos vectorial]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Vectores dense y sparse, chunks y metadatos del corpus científico&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="330" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="con_doctor" value="&lt;b&gt;Doctor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="con_llm" value="&lt;b&gt;Proveedor de LLM&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Self-hosted o cloud (pendiente ADR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="800" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="con_ext" value="&lt;b&gt;Fuentes científicas externas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NCI, PDQ, ensayos clínicos, plataformas genómicas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="800" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="con_e1" value="Usa&#10;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="con_doctor" target="con_web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="con_e2" value="Llama a la API&#10;[HTTPS, cookie de sesión HttpOnly]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="con_web" target="con_be1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="con_e3" value="Lee/escribe&#10;[Prisma, SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="con_be1" target="con_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="con_e4" value="Delega extracción de documentos y consultas RAG&#10;[HTTPS, JWT interno]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="con_be1" target="con_be2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="con_e5" value="Consulta vectores dense/sparse&#10;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="con_be2" target="con_milvus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="con_e6" value="Solicita embeddings e inferencia&#10;[API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="con_be2" target="con_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="con_e7" value="Ingiere corpus científico&#10;[batch]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="con_be2" target="con_ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_obs_note" value="Observabilidad (2.7): Web, clinical-api y rag-orchestrator exponen /metrics (Prometheus) y /health. Prometheus + Grafana como contenedores propios: pendiente de ADR — no se agregan todavía." style="text;html=1;align=left;fontSize=10;fontColor=#666666;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="240" y="700" width="1080" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-component" name="Nivel 3 - Componentes">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="cmp_note" value="Zoom a los 2 contenedores con estructura interna relevante (clinical-api y rag-orchestrator). Web (Next.js) no tiene un diagrama de componentes propio por ahora." style="text;html=1;align=left;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="cmp_b1" value="clinical-api (Backend 1)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="700" height="860" as="geometry" />
        </mxCell>

        <mxCell id="cmp_mw" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Auth · Authorize · validación Zod · error handler · genera traceId (2.7)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="620" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cmp_users" value="&lt;b&gt;UsersController + UsersService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — módulo users]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Autenticación, RBAC (Role/Permission), asignación doctor-paciente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_clinical" value="&lt;b&gt;PatientsController + PatientsService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — módulos patients/exams/&lt;br&gt;clinical-history/treatments]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Registro clínico: pacientes, exámenes, historia clínica, tratamientos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_ragw" value="&lt;b&gt;RagGatewayController + RagGatewayService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Resuelve el contexto clínico autorizado y hace de proxy hacia Backend 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_hist" value="&lt;b&gt;AnalysisHistoryService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — módulo ai-analysis]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Persiste el historial de análisis IA devuelto por Backend 2 (trazabilidad)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="340" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_repo1" value="&lt;b&gt;Repository Layer (Prisma)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;user · patient · clinical-record · analysis repositories&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="620" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cmp_client" value="&lt;b&gt;RagOrchestratorClient&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — infrastructure]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Firma y adjunta el JWT de servicio en cada llamada a Backend 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="620" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cmp_pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor externo]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cmp_b2" value="rag-orchestrator (Backend 2)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="50" width="760" height="860" as="geometry" />
        </mxCell>

        <mxCell id="cmp_auth2" value="&lt;b&gt;ServiceAuthMiddleware&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Valida el JWT de servicio · propaga traceId recibido en logs (2.7)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="680" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cmp_routers" value="&lt;b&gt;RagQueryRouter + DocumentExtractionRouter&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — api]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Endpoints /rag/query y /documents/extract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="190" width="680" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cmp_ragsvc" value="&lt;b&gt;RAGOrchestratorService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — application]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Retrieval dense/sparse/híbrido, context assembly, invoca LLM, valida respuesta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="300" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cmp_docsvc" value="&lt;b&gt;DocumentExtractionService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — application]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OCR/extracción asistida por IA (técnica exacta: ADR pendiente)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="300" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cmp_ingsvc" value="&lt;b&gt;IngestionPipelineService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — application]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Normaliza y embebe el corpus externo (NCI, PDQ, ensayos)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="440" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_domain" value="&lt;b&gt;Domain — Evidence Scoring&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — domain]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reglas de negocio puras: umbrales de confianza, ranking de evidencia clínica&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9E0A5;strokeColor=#5A9E3D;fontColor=#274D16;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="440" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_milvusrepo" value="&lt;b&gt;MilvusRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — infrastructure]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">

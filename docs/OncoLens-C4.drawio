              <mxCell id="cmp_v11_timeline" value="&lt;b&gt;★ CaseTimelineService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — case-timeline · clinical-events]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Timeline: eventos derivados de sus tablas + ClinicalEvent (solo tipos sin tabla) + ClinicalAttribute, tratamientos previos, series de biomarcadores, evolución registrada por el oncólogo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;strokeWidth=2;" vertex="1" parent="1">

        <mxCell id="cmp_v11_basis" value="&lt;b&gt;★ AnalysisBasis · Memory · StaleDetector&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — evidence-analysis (módulo único)]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Base del análisis (T-2); memoria por paciente (sin desactualizados), no citable; dos marcas de desactualizado y cascada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;strokeWidth=2;" vertex="1" parent="1">

        <mxCell id="con_e3" value="Lee/escribe&#10;[Prisma, SQL, TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=0.3;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="con_be1" target="con_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e4" value="Guarda/lee PDFs&#10;[S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=0.8;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="con_be1" target="con_cminio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e5" value="Análisis de evidencia y extracción
[HTTP, JWT de servicio ES256]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=1;exitY=0.4;entryX=0;entryY=0.348;" edge="1" parent="1" source="con_be1" target="con_be2">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="con_e6" value="Búsqueda dense/sparse&#10;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_be2" target="con_milvus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e7" value="Catálogo del corpus: solo schema corpus&#10;[rol rag_corpus, corpus-db-net, TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;dashed=1;exitX=0.2;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="con_be2" target="con_pg">
          <mxGeometry relative="1" x="-0.45" as="geometry"><Array as="points"><mxPoint x="812" y="615" /><mxPoint x="440" y="615" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="con_e8" value="Generación, estructuración, expansión&#10;[host.docker.internal, API OpenAI-compatible]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="con_be2" target="con_llm">
          <mxGeometry relative="1" x="0.1" as="geometry"><Array as="points"><mxPoint x="890" y="300" /><mxPoint x="1135" y="300" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry>

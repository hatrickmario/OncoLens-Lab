          <mxGeometry relative="1" x="-0.6" as="geometry"><Array as="points"><mxPoint x="1290" y="555.5" /><mxPoint x="1290" y="715" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="con_note" value="Solo web publica un puerto (interfaz de la red privada/VPN). Solo PostgreSQL y Milvus como motores. rag-orchestrator: sin ruta hacia clinical-minio; hacia PostgreSQL solo por corpus-db-net con el rol rag_corpus, limitado al schema corpus (pg_hba restringido, tests de acceso denegado). /health y /metrics en ambos backends; Prometheus + Grafana y OpenTelemetry: ADR futuro. Datos reales solo tras el Sprint 5 y el gate G-piloto. v1.2: packages/clinical-catalogs (datos críticos, aplicabilidad, CIE-10/LOINC/CUPS/ATC, plantillas) artefacto JSON versionado, montado en clinical-api y rag-orchestrator (409 si la versión difiere)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="250" y="990" width="1030" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-component" name="Nivel 3 - Componentes">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="cmp_note" value="Zoom a los 2 contenedores con estructura interna relevante. Web (Next.js) actúa como BFF y no tiene diagrama de componentes propio por ahora. ★ = componente nuevo en v1.1 o v1.2 (ver docs/TO-BE.md)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cmp_b1" value="clinical-api (Backend 1)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="780" height="1110" as="geometry" />
        </mxCell>

        <mxCell id="cmp_mw" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Guard de sesión · autorización (RBAC + equipo tratante + opt-out) · Origin/CSRF · rate limit · Zod · traceId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#5C1A18;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="330" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cmp_users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — módulo users]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Login/logout, sesiones (TTL, inactividad), Argon2id, bloqueo por intentos, RBAC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmp_patients" value="&lt;b&gt;Patients&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — patients · episodes · care-team · consents]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Registro (manual / asistido por OCR), listado y búsqueda, episodios (egreso/reactivación), equipo tratante, marcas de opt-out (admin) y baja total; egresado sin registros&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cmp_identity" value="&lt;b&gt;IdentityService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — identity]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cifrado AES-256-GCM + índice ciego HMAC. Único acceso al schema identity; la identidad nunca sale del servicio salvo hacia el doctor autorizado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#5C1A18;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="220" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cmp_docs" value="&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — documents]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Carga (magic bytes, checksum), clinical-minio, estado, visor del documento de origen (auditado)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cmp_worker" value="&lt;b&gt;ExtractionWorker&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — workers]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cola Document (SKIP LOCKED). Verifica identidad del documento, cuarentena PII, persiste con confianza y review_status; eventos y tratamientos previos; delega la reconciliación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="370" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cmp_review" value="&lt;b&gt;ClinicalReview&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — clinical-data]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Verificar / corregir / rechazar datos extraídos; regla de vigencia de diagnósticos por fecha; conflictos y términos no_mapeado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="370" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cmp_gw" value="&lt;b&gt;EvidenceGateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — evidence-analysis (módulo único)]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Contexto del caso etiquetado (línea, trayectorias, códigos); desidentificación (seudónimo por consulta, fechas relativas, enmascarado de PII); sin opt-out de IA y paciente activo; tipo de cáncer habilitado; dataClassification; deadline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="330" height="145" as="geometry" />
        </mxCell>

        <mxCell id="cmp_hist" value="&lt;b&gt;AnalysisHistory&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — evidence-analysis]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Persiste AIAnalysisRecord (contexto, modelos, prompt, descartadas, versiones) antes de responder; historial, re-ejecución y comparación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="520" width="190" height="145" as="geometry" />
        </mxCell>

        <mxCell id="cmp_ret" value="&lt;b&gt;RetentionJobs&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — workers]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Política de retención (job automático: Post-MVP), baja total; opt-out de investigación borra el histórico, job de mayoría de edad, snapshot longitudinal al egresar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">

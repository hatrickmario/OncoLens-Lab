<mxfile host="app.diagrams.net" agent="OncoLens" version="24.0.0">
  <diagram id="c4-context" name="Nivel 1 - Contexto">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ctx_doctor" value="&lt;b&gt;Oncólogo&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Piloto inicial: 10 oncólogos. Busca pacientes, carga documentos, revisa el caso reconstruido y los datos faltantes, analiza la evidencia y registra decisiones y evolución. Accede solo por red privada o VPN.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="140" as="geometry" />
        </mxCell>

        <mxCell id="ctx_admin" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gestiona usuarios, equipo tratante, egresos y el marcas de opt-out (los consentimientos firmados reposan en el sistema externo) y política de retención.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="ctx_oncolens" value="&lt;b&gt;OncoLens&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema de software — MVP académico]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reconstruye el caso (timeline, tratamientos previos; CIE-10/LOINC/CUPS/ATC), señala datos faltantes y presenta un análisis de evidencia pública (búsqueda híbrida ES/EN): síntesis, aplicabilidad al paciente y opciones descritas, con citas verificables. No prescribe ni estima probabilidad de éxito. Corre en local: Docker Compose + LLM nativo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=13;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="250" width="340" height="220" as="geometry" />
        </mxCell>

        <mxCell id="ctx_ext" value="&lt;b&gt;Fuentes científicas externas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Solo texto, con licencia registrada: NCI PDQ (EN/ES), ClinicalTrials.gov, PubMed/PMC y publicaciones de TCGA/GDC, cBioPortal y TCIA. Solo fuentes públicas de acceso abierto en el MVP; NCCN y ESMO no incluidas (no bloquean).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="60" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="ctx_cloud" value="&lt;b&gt;LLM en la nube (opcional)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Deshabilitado por defecto. Solo para pruebas con datos sintéticos; los datos reales nunca salen del equipo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ctx_entity" value="&lt;b&gt;Entidad médica / colaboradores&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Contrato o convenio marco. Entregan datasets reales anonimizados (calibración y pruebas) y custodian los consentimientos firmados; comunican las exclusiones (opt-out), que el administrador registra.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="520" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="ctx_e1" value="Consulta pacientes y evidencia, carga documentos&#10;[HTTPS, red privada/VPN]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="ctx_doctor" target="ctx_oncolens">
          <mxGeometry relative="1" x="0.1" as="geometry"><Array as="points"><mxPoint x="350" y="180" /><mxPoint x="350" y="316" /></Array><mxPoint x="78" y="0" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="ctx_e2" value="Administra&#10;[HTTPS, red privada/VPN]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="ctx_admin" target="ctx_oncolens">
          <mxGeometry relative="1" x="-0.3" as="geometry"><Array as="points"><mxPoint x="535" y="545" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="ctx_e3" value="Ingiere publicaciones con licencia&#10;[batch]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=0.75;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="ctx_oncolens" target="ctx_ext">
          <mxGeometry relative="1" x="0.25" as="geometry"><Array as="points"><mxPoint x="705" y="135" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="ctx_e4" value="Inferencia solo con datos sintéticos&#10;[HTTPS, opcional]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ctx_oncolens" target="ctx_cloud">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="ctx_e5" value="Datasets anonimizados y opt-outs&#10;[importación]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;exitX=0;exitY=0.5;entryX=0.75;entryY=1;" edge="1" parent="1" source="ctx_entity" target="ctx_oncolens">
          <mxGeometry relative="1" x="-0.3" as="geometry"><Array as="points"><mxPoint x="705" y="590" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="ctx_note" value="Alcance clínico del piloto: cáncer de mama y de próstata; leucemia como tercer tipo cuando cumpla su criterio de &quot;listo&quot;; captura de menores incluida. v1.2 (ver docs/TO-BE.md). Toda salida: &quot;Análisis generado por IA — requiere validación clínica&quot; y &quot;Uso académico/investigación&quot;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="640" width="620" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-container" name="Nivel 2 - Contenedores">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="con_boundary" value="OncoLens — MacBook Pro M5 (FileVault) · Docker Compose + LLM nativo" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=14;fontColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="1030" height="940" as="geometry" />
        </mxCell>

        <mxCell id="con_net_clin" value="red clinical-net (clinical-api también en ai-net; PostgreSQL también en corpus-db-net)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="460" height="760" as="geometry" />
        </mxCell>

        <mxCell id="con_net_ai" value="red ai-net" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="745" y="300" width="510" height="540" as="geometry" />
        </mxCell>

        <mxCell id="con_doctor" value="&lt;b&gt;Oncólogo / Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="con_web" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Next.js / React 19 (BFF)]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UI del doctor (ficha, vista de caso, panel de análisis de evidencia) y único punto público (HTTPS, CA interna). Route Handlers como proxy de todos los endpoints; cookie SameSite=Strict + verificación de Origin. Nunca tokens del LLM sin validar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="240" height="170" as="geometry" />
        </mxCell>

        <mxCell id="con_be1" value="&lt;b&gt;clinical-api&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Node.js LTS / Express 5]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Plataforma clínica + gateway de IA. Auth, equipo tratante, marcas de opt-out, identidad cifrada (índice ciego), documentos, revisión OCR, caso longitudinal (timeline, tratamientos previos, evolución), reconciliación y normalización final (dueño), checklist de faltantes, gateway del análisis de evidencia (Base del análisis, memoria, desactualizados), retención (política). Worker de extracción y job de mayoría de edad. Sin puerto al host.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="240" height="200" as="geometry" />
        </mxCell>

        <mxCell id="con_pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Base de datos]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Único motor relacional. Schemas auth · identity (cifrado) · clinical · audit · research (solo inserción) · corpus (solo rag-orchestrator, rol rag_corpus).&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="640" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="con_cminio" value="&lt;b&gt;clinical-minio&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Object storage]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bucket clinical-documents (PDFs). Solo clinical-api tiene credenciales y red.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="640" width="190" height="140" as="geometry" />
        </mxCell>

        <mxCell id="con_be2" value="&lt;b&gt;rag-orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Python / FastAPI]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Recuperación híbrida multilingüe, reranker, generación, citas y soporte NLI; extracción (capa de texto/OCR, gate de PII, confianza por campo); síntesis, aplicabilidad, agente acotado de búsqueda complementaria y orden por aplicabilidad; resumen del caso; eventos, tratamientos previos y propuesta de códigos CIE-10/LOINC/CUPS/ATC; ingesta del corpus abierto con metadatos estructurados. Embeddings, reranker y NLI en CPU. Sin acceso a datos clínicos: en PostgreSQL solo el schema corpus; sin red hacia clinical-minio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="260" height="230" as="geometry" />
        </mxCell>

        <mxCell id="con_milvus" value="&lt;b&gt;Milvus&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Base de datos vectorial (+ etcd + MinIO propio)]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;corpus_chunks: dense + sparse, is_current, source_type, language, cancer_type_tags, population.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="640" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="con_llm" value="&lt;b&gt;LLM nativo&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Proceso nativo macOS — fuera de Docker]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ollama o vLLM con GPU Metal; API compatible con OpenAI. Modelo fijado por el ADR de modelos locales.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=10;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="110" width="230" height="140" as="geometry" />
        </mxCell>

        <mxCell id="con_cloud" value="&lt;b&gt;LLM en la nube (opcional)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Solo datos sintéticos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="380" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="con_ext" value="&lt;b&gt;Fuentes científicas externas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Solo acceso abierto: PDQ, ClinicalTrials.gov, PubMed/PMC OA, guías públicas, publicaciones TCGA/GDC, cBioPortal, TCIA.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="650" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="con_e1" value="Usa&#10;[HTTPS, red privada/VPN]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_doctor" target="con_web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="con_e2" value="Proxy de la API&#10;[HTTP interno, cookie de sesión]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;startArrow=none;fontColor=#333333;strokeColor=#333333;align=center;" edge="1" parent="1" source="con_web" target="con_be1">

        <mxCell id="cmp_v11_complete" value="&lt;b&gt;★ CompletenessService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — completeness]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Checklist determinista de datos críticos por tipo de cáncer; faltantes → &quot;desconocido&quot;; no bloquea&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;strokeWidth=2;" vertex="1" parent="1">

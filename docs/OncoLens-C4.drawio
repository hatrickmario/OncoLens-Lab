        <mxCell id="cmp_rag" value="&lt;b&gt;RAGOrchestratorService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — application]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Idioma → expansión bilingüe → retrieval (filtros) → reranker → umbral → orquesta síntesis y aplicabilidad → validación → orden determinista por aplicabilidad; memoria no citable; agente acotado: hasta 3 sub-consultas si un criterio queda sin evidencia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;" vertex="1" parent="1">

        <mxCell id="cmp_v11_recon" value="&lt;b&gt;★ ReconciliationService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente — reconciliation]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Duplicados → un dato con varias fuentes (ClinicalDataSource); conflictos → requiere_revision; normalización final CIE-10/LOINC/CUPS/ATC (dueño; también datos manuales)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#1E6EB4;fontColor=#0B3D6E;align=center;verticalAlign=middle;fontSize=11;arcSize=8;strokeWidth=2;" vertex="1" parent="1">

{
  "name": "oncolens",
  "private": true,
  "type": "module",
  "description": "Monorepo de OncoLens (npm workspaces): web, clinical-api y packages/*. rag-orchestrator es Python y vive fuera de los workspaces.",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/web",
    "apps/clinical-api",
    "packages/*"
  ],
  "scripts": {
    "contracts:check": "node scripts/contracts/check.mjs",
    "contracts:generate": "node scripts/contracts/generate.mjs",
    "contracts:generate:check": "node scripts/contracts/generate-check.mjs",
    "contracts:readme-extract": "node scripts/contracts/readme-extract.mjs",
    "test:infra": "vitest run infra scripts/smoke",
    "smoke:compose": "bash scripts/smoke/compose-smoke.sh"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/openapi-core": "2.62.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-json-patch": "3.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  }
}

{
  "name": "oncolens",
  "private": true,
  "type": "module",
  "description": "Monorepo de OncoLens (npm workspaces): web, clinical-api y packages/*. rag-orchestrator es Python y vive fuera de los workspaces.",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/web",
    "apps/clinical-api",
    "packages/*"
  ],
  "scripts": {
    "precontracts:check": "npm run build -w @oncolens/clinical-language",
    "contracts:check": "node scripts/contracts/check.mjs",
    "contracts:generate": "node scripts/contracts/generate.mjs",
    "contracts:generate:check": "node scripts/contracts/generate-check.mjs",
    "contracts:verify-provider": "node scripts/contracts/verify-provider.mjs",
    "contracts:breaking": "bash scripts/ci/contracts-breaking.sh origin/main",
    "contracts:readme-extract": "node scripts/contracts/readme-extract.mjs",
    "eval:pii": "npm run eval:pii -w @oncolens/clinical-api --",
    "evaluate": "node scripts/eval/evaluate.mjs",
    "lint:lenguaje": "tsx packages/clinical-language/bin/lint-lenguaje.ts",
    "test:lenguaje": "vitest run ci/tests/lenguaje",
    "test:quality": "vitest run --config vitest.quality.config.ts",
    "test:infra": "vitest run infra scripts/smoke",
    "smoke:compose": "bash scripts/smoke/compose-smoke.sh",
    "test:e2e": "bash scripts/e2e/ejecutar.sh",
    "test:secrets": "bash scripts/tests/setup-secrets.test.sh",
    "lint": "eslint . --max-warnings 0",
    "format:js": "prettier \"apps/web/**/*.{ts,tsx,js,jsx,mjs,cjs,css}\" \"apps/clinical-api/**/*.{ts,js,mjs,cjs}\" \"packages/**/*.{ts,tsx,js,mjs,cjs}\"",
    "format": "npm run format:js -- --write && npm run format:py",
    "format:check": "npm run format:js -- --check && npm run format:py:check",
    "format:py": "node scripts/quality/ruff.mjs",
    "format:py:check": "node scripts/quality/ruff.mjs --check"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@redocly/openapi-core": "2.62.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-json-patch": "3.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  }
}

# Variables del Compose local (US-034). Copiar a .env junto al docker-compose.yml.
# Sin secretos (RN-14): las claves y contraseñas son archivos en ONCOLENS_SECRETS_DIR (scripts/setup-secrets.sh).
# Todo valor a calibrar vive aquí (RN-22).

COMPOSE_PROJECT_NAME=oncolens
APP_ENV=local
ONCOLENS_SECRETS_DIR=./secrets
# uid:gid del usuario que ejecutó scripts/setup-secrets.sh (`id -u`, `id -g`): dueño de los secretos 0600, con el que
# corren clinical-api y rag-orchestrator para leerlos sin relajar permisos. 1000 es el primer usuario de Linux.
ONCOLENS_UID=1000
ONCOLENS_GID=1000

# Publicación (solo web publica puerto; SEG-09)
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Healthchecks
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=12
HEALTHCHECK_START_PERIOD=20s
MILVUS_HEALTHCHECK_START_PERIOD=90s

# PostgreSQL / MinIO / etcd
POSTGRES_DB=oncolens
CLINICAL_MINIO_ROOT_USER=clinical-minio-admin
MILVUS_MINIO_ROOT_USER=milvus-minio-admin
ETCD_QUOTA_BACKEND_BYTES=4294967296

# Catálogos clínicos (montados de solo lectura en ambos backends)
CLINICAL_CATALOG_PATH=/catalogs

# rag-orchestrator
RAG_TMPFS_SIZE=256m
LLM_PROVIDER=local
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_HEALTH_TIMEOUT_MS=2000
LLM_CLOUD_ENABLED=false
REAL_ANONYMIZED_ENABLED=false
REAL_IDENTIFIED_ENABLED=false
FAKE_RESPONSES_PATH=/contracts/examples

# JWT de servicio (US-036, L1D-105): vigencia y ruta de la clave privada de clinical-api.
# Solo nombres y rutas, sin valores secretos: la clave es un secreto de Compose (jwt_service_private.pem).
SERVICE_JWT_TTL_SECONDS=60
SERVICE_JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_service_private.pem
# Subredes fijas (las referencia pg_hba.conf, US-035) y TLS de PostgreSQL
CLINICAL_NET_SUBNET=172.28.10.0/24
CORPUS_DB_NET_SUBNET=172.28.20.0/24
PG_CA_VALID_DAYS=3650
PG_CERT_VALID_DAYS=825
PG_RAG_CORPUS_CONNECTION_LIMIT=10
PG_RAG_CORPUS_MIGRATOR_CONNECTION_LIMIT=2

# Prefijo de las bases por ejecución de los arneses de test (solo perfil test/CI; validado por scripts/setup-secrets.sh)
PG_TEST_DB_PREFIX=oltest_
